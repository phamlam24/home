---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { isLoggedIn } from '../lib/auth';
import { AUTH_ORIGIN } from '../lib/authOrigin';

interface AppLink {
  name: string;
  href: string;
  description: string;
  requiresLogin: boolean;
}

// Add a new app here once it's deployed — that's the only edit needed to
// surface it on this hub.
const APPS: AppLink[] = [
  {
    name: 'Climbing Tracker',
    href: 'https://climbing.lampham.space',
    description: 'Personal bouldering/lead log',
    requiresLogin: false,
  },
  {
    name: 'Learn',
    href: 'https://learn.lampham.space',
    description: 'Course app for this stack',
    requiresLogin: true,
  },
  {
    name: 'Sprout',
    href: 'https://sprout.lampham.space',
    description: 'Weekly point-based questing tracker',
    requiresLogin: true,
  },
];

const loggedIn = await isLoggedIn(Astro.request, Astro.cookies);
const visibleApps = APPS.filter((app) => !app.requiresLogin || loggedIn);

const isLocalhost = Astro.url.hostname === 'localhost' || Astro.url.hostname === '127.0.0.1';
const redirect = encodeURIComponent(Astro.url.href);
const loginUrl = `${AUTH_ORIGIN}/login?redirect=${redirect}`;
const logoutUrl = `${AUTH_ORIGIN}/logout?redirect=${redirect}`;
---

<BaseLayout title="Apps | Lam Pham" description="Apps I've shipped and self-host, all running on my own infrastructure.">
  <div class="min-h-screen flex flex-col">
    <section class="reveal mx-auto max-w-3xl w-full px-6 py-20 flex-1">
      <a href="/" class="text-xs text-muted hover:text-accent-h transition-colors">← back</a>

      <div class="mt-6 flex items-start justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold text-text" style="font-family: var(--font-display);">Apps</h1>
        </div>
        {!isLocalhost && (
          <a
            href={loggedIn ? logoutUrl : loginUrl}
            class="text-sm font-semibold text-accent hover:text-accent-h transition-colors mt-1 shrink-0"
          >
            {loggedIn ? 'Log out' : 'Log in'}
          </a>
        )}
      </div>

      <nav class="mt-10 flex flex-col gap-3">
        {visibleApps.map((app) => (
          <a
            href={app.href}
            class="card-tilt block rounded-lg border border-border bg-surface px-5 py-4 no-underline"
          >
            <span class="block text-base font-semibold text-text">{app.name}</span>
            <span class="block text-sm text-muted">{app.description}</span>
          </a>
        ))}
      </nav>
    </section>

    <Footer loggedIn={loggedIn} />
  </div>

  <script src="../scripts/reveal.ts"></script>
  <script src="../scripts/card-tilt.ts"></script>
</BaseLayout>
