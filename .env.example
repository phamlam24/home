# Must be IDENTICAL to the JWT_SECRET in server-auth's .env — auth issues
# tokens, this app only verifies them locally, so a mismatch silently breaks
# login detection. On localhost, this app always shows the logged-in link set
# regardless of this.
JWT_SECRET=change-me-to-a-long-random-value

# Origin of the shared auth service, used for the login/logout links and by
# src/middleware.ts to refresh an expired access token.
AUTH_ORIGIN=https://auth.lampham.space

# Must match the COOKIE_DOMAIN/COOKIE_SECURE server-auth is using — only
# relevant to src/middleware.ts, which re-sets the access_token cookie after
# a refresh. Leave unset in production. For local dev over plain http://:
#   COOKIE_DOMAIN=.lampham.test
#   COOKIE_SECURE=false
COOKIE_DOMAIN=.lampham.space
COOKIE_SECURE=true
