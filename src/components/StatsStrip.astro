---
interface Stat {
  value: string;
  label: string;
}

const stats: Stat[] = [
  { value: 'Silver Medal', label: 'ICPC Northeast NA (Nov 2025)' },
  { value: '3 Hackathon Wins', label: '@ UC Berkeley, JHU, and more...' },
  { value: '250K+', label: 'Daily users served at Fetch Rewards' },
];
---

<section class="reveal border-y border-border bg-surface/40">
  <div class="mx-auto max-w-4xl grid grid-cols-1 sm:grid-cols-3 gap-4 px-6 py-12">
    {stats.map((stat) => (
      <div class="rounded-card border border-border bg-surface/60 px-5 py-4 text-center sm:text-left">
        <p class="mt-1 font-semibold text-text font-display">{stat.value}</p>
        <p class="mt-1 text-xs text-muted">{stat.label}</p>
      </div>
    ))}
  </div>
</section>
