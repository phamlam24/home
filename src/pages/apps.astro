---
import BaseLayout from '../layouts/BaseLayout.astro';
import SuiteHeader from '../components/lampham/SuiteHeader.astro';
import SuiteFooter from '../components/lampham/SuiteFooter.astro';
import type { SuiteAppId } from '../components/lampham/suite';
import { isLoggedIn } from '../lib/auth';
import { AUTH_ORIGIN } from '../lib/authOrigin';

interface AppLink {
  /** Suite id — picks the app's accent dot (design/css/tokens.css). */
  id: SuiteAppId;
  name: string;
  href: string;
  description: string;
  requiresLogin: boolean;
}

// Add a new app here once it's deployed — that's the only edit needed to
// surface it on this hub.
const APPS: AppLink[] = [
  {
    id: 'climb',
    name: 'Climbing Tracker',
    href: 'https://climbing.lampham.space',
    description: 'Personal bouldering/lead log',
    requiresLogin: false,
  },
  {
    id: 'learn',
    name: 'Learn',
    href: 'https://learn.lampham.space',
    description: 'Course app for this stack',
    requiresLogin: true,
  },
  {
    id: 'sprout',
    name: 'Sprout',
    href: 'https://sprout.lampham.space',
    description: 'Weekly point-based questing tracker',
    requiresLogin: true,
  },
];

const loggedIn = await isLoggedIn(Astro.request, Astro.cookies);
const visibleApps = APPS.filter((app) => !app.requiresLogin || loggedIn);

const isLocalhost = Astro.url.hostname === 'localhost' || Astro.url.hostname === '127.0.0.1';
const redirect = encodeURIComponent(Astro.url.href);
const loginUrl = `${AUTH_ORIGIN}/login?redirect=${redirect}`;
const logoutUrl = `${AUTH_ORIGIN}/logout?redirect=${redirect}`;
const authHref = isLocalhost ? undefined : loggedIn ? logoutUrl : loginUrl;
---

<BaseLayout title="Apps | Lam Pham" description="Apps I've shipped and self-host, all running on my own infrastructure.">
  <div class="min-h-screen flex flex-col">
    <SuiteHeader current="home" loggedIn={loggedIn} authHref={authHref} />

    <section class="reveal mx-auto max-w-3xl w-full px-6 py-16 flex-1">
      <a href="/" class="text-xs text-muted hover:text-accent-h transition-colors">← back</a>

      <h1 class="mt-6 text-3xl text-text">Apps</h1>

      <nav class="mt-10 flex flex-col gap-3">
        {visibleApps.map((app) => (
          <a href={app.href} class="lp-card card-tilt block px-5 py-4 no-underline hover:no-underline">
            <span class="flex items-center gap-2.5 font-semibold text-text">
              <span class="lp-dot lp-dot-accent" data-app={app.id} aria-hidden="true"></span>
              {app.name}
            </span>
            <span class="mt-0.5 block pl-5 text-sm text-muted">{app.description}</span>
          </a>
        ))}
      </nav>
    </section>

    <SuiteFooter />
  </div>

  <script src="../scripts/reveal.ts"></script>
  <script src="../scripts/card-tilt.ts"></script>
</BaseLayout>
